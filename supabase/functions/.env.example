# Secrets ของ Edge Functions (local: supabase functions serve --env-file supabase/functions/.env)
# Production: supabase secrets set KEY=value
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY / SUPABASE_ANON_KEY ระบบใส่ให้อัตโนมัติ

# origin ของ Staff App และ Customer App คั่นด้วย comma
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Cloudflare Turnstile — ค่าด้านล่างคือ test secret ของ Cloudflare (ผ่านเสมอ) ใช้ระหว่างพัฒนาเท่านั้น
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# SlipOK — API key จากหน้า SlipOK (Branch ID ตั้งต่อสาขาใน Staff App > บัญชีรับมัดจำ)
# ถ้าไม่ตั้ง สลิปทุกใบจะส่งให้พนักงานตรวจ
SLIPOK_API_KEY=

# (ทางเลือก) ใช้ API key แบบใหม่แทน key เดิม
# SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Cloudinary — รูปบริการ/รูปสาขา (Edge Function cloudinary-sign เซ็นการอัปโหลด)
# ค่าจาก Cloudinary Console > Settings > API Keys (API secret ห้ามใส่ฝั่งแอป)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
