{
  "name": "ifeew-thaimassage",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:customer": "pnpm --filter @ifeew/customer dev",
    "dev:staff": "pnpm --filter @ifeew/staff dev",
    "build": "pnpm -r --filter ./apps/* build",
    "typecheck": "pnpm -r --filter ./apps/* typecheck",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:lint": "supabase db lint --level warning",
    "db:types": "supabase gen types typescript --local --schema public > packages/shared/src/database.types.ts",
    "functions:serve": "supabase functions serve --env-file supabase/functions/.env"
  },
  "devDependencies": {
    "supabase": "^3.0.0"
  }
}
