      "css": ".ds-stat{font-family:'DM Sans','Noto Sans Thai',system-ui,sans-serif;display:flex;gap:16px;align-items:flex-start;padding:20px;background:var(--card,#fffcf8);border:1px solid var(--border,#ede4da);border-radius:16px;box-shadow:0 4px 20px rgba(111,83,57,.055)}.ds-stat-icon{display:grid;place-items:center;width:48px;height:48px;border-radius:50%;background:var(--muted,#f4ebe1);color:var(--brand-accent,#a9825e);font-size:20px}.ds-stat-label{display:block;font-size:14px;color:var(--muted-foreground,#7a6e61)}.ds-stat-value{display:block;margin-top:6px;font-size:30px;line-height:1;color:var(--heading,#514337);font-variant-numeric:tabular-nums}"
    }
