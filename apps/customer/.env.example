# Customer App — ใช้เฉพาะ Publishable Key (ห้ามใส่ Secret/Service Role Key ในแอป)
NUXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NUXT_PUBLIC_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# รหัสบริษัท (companies.code)
NUXT_PUBLIC_COMPANY_CODE=IFEEW
# URL ของ Edge Functions (ไม่ต้องตั้งถ้าใช้ {SUPABASE_URL}/functions/v1)
NUXT_PUBLIC_FUNCTIONS_URL=
# Cloudflare Turnstile site key (production ต้องใช้ key จริง)
NUXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Sentry (ว่าง = ปิด) และชื่อสภาพแวดล้อม
NUXT_PUBLIC_SENTRY_DSN=
NUXT_PUBLIC_APP_ENV=development
