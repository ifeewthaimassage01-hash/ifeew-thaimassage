# Staff App — ใช้เฉพาะ Publishable Key (ห้ามใส่ Secret/Service Role Key ในแอป)
NUXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NUXT_PUBLIC_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# ไม่ต้องตั้งถ้าใช้ {SUPABASE_URL}/functions/v1
NUXT_PUBLIC_FUNCTIONS_URL=
# URL ของ Customer App (ลิงก์ชำระมัดจำที่พนักงานส่งให้ลูกค้า)
NUXT_PUBLIC_CUSTOMER_APP_URL=http://localhost:3000

# Sentry (ว่าง = ปิด) และชื่อสภาพแวดล้อม
NUXT_PUBLIC_SENTRY_DSN=
NUXT_PUBLIC_APP_ENV=development
